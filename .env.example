# Optional. The site builds and works without these; the contact form then shows a
# friendly "not available" message and usage counting is skipped.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key only. NEVER put the service_role key in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
